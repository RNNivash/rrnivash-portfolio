    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { motion } from \"motion/react\";\nimport { ArrowRight, FileText, Github, Linkedin, Mail, Terminal, Cpu, Database, Network } from \"lucide-react\";\nimport { personalInfo } from \"../data/portfolioData\";\n\nexport default function Hero() {\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    visible: {\n      opacity: 1,\n      transition: {\n        staggerChildren: 0.1,\n        delayChildren: 0.1,\n      },\n    },\n  };\n\n  const itemVariants = {\n    hidden: { y: 20, opacity: 0 },\n    visible: {\n      y: 0,\n      opacity: 1,\n      transition: { duration: 0.8, ease: [0.16, 1, 0.3, 1] },\n    },\n  };\n\n  const scrollToContact = () => {\n    const el = document.getElementById(\"contact\");\n    if (el) {\n      const offset = 80;\n      const bodyRect = document.body.getBoundingClientRect().top;\n      const elRect = el.getBoundingClientRect().top;\n      const elPosition = elRect - bodyRect;\n      const offsetPosition = elPosition - offset;\n      window.scrollTo({ top: offsetPosition, behavior: \"smooth\" });\n    }\n  };\n\n  return (\n    <section\n      id=\"hero\"\n      className=\"relative min-h-screen pt-32 pb-20 md:pt-40 md:pb-28 flex items-center overflow-hidden\"\n    >\n      {/* Decorative Grid Backdrop (Subtle) */}\n      <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#141416_1px,transparent_1px),linear-gradient(to_bottom,#141416_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,#000_70%,transparent_100%)] -z-10\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center\">\n        {/* Left Column: Typography & CTAs */}\n        <motion.div\n          variants={containerVariants}\n          initial=\"hidden\"\n          animate=\"visible\"\n          className=\"lg:col-span-7 flex flex-col justify-center space-y-8\"\n          id=\"hero-left-content\"\n        >\n          {/* Subtle Tag */}\n          <motion.div variants={itemVariants} className=\"inline-flex\">\n            <span className=\"inline-flex items-center space-x-2 bg-neutral-900 border border-neutral-800 rounded-full px-3.5 py-1 text-[11px] font-mono font-medium tracking-tight text-neutral-400\">\n              <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse\" />\n              <span>Available for select AI Engineering projects</span>\n            </span>\n          </motion.div>\n\n          <div className=\"space-y-4\">\n            {/* Name & Title */}\n            <motion.div variants={itemVariants}>\n              <span className=\"text-sm font-mono text-neutral-500 tracking-wider uppercase block mb-1\">\n                {personalInfo.title}\n              </span>\n              <h1 className=\"text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-white font-sans leading-[1.1]\">\n                {personalInfo.name}\n              </h1>\n            </motion.div>\n\n            {/* Headline */}\n            <motion.p\n              variants={itemVariants}\n              className=\"text-base sm:text-lg md:text-xl text-neutral-400 font-sans font-light max-w-xl leading-relaxed\"\n            >\n              {personalInfo.headline}\n            </motion.p>\n          </div>\n\n          {/* Key pillars labels */}\n          <motion.div\n            variants={itemVariants}\n            className=\"grid grid-cols-3 gap-4 border-t border-b border-neutral-900 py-4 max-w-lg\"\n          >\n            <div className=\"flex items-center space-x-2\">\n              <Cpu className=\"h-4 w-4 text-neutral-600\" />\n              <span className=\"text-xs font-mono text-neutral-400\">LLMs & Agents</span>\n            </div>\n            <div className=\"flex items-center space-x-2\">\n              <Network className=\"h-4 w-4 text-neutral-600\" />\n              <span className=\"text-xs font-mono text-neutral-400\">MCP Protocol</span>\n            </div>\n            <div className=\"flex items-center space-x-2\">\n              <Database className=\"h-4 w-4 text-neutral-600\" />\n              <span className=\"text-xs font-mono text-neutral-400\">Scalable Systems</span>\n            </div>\n          </motion.div>\n\n          {/* Action Buttons */}\n          <motion.div\n            variants={itemVariants}\n            className=\"flex flex-wrap gap-3\"\n            id=\"hero-actions\"\n          >\n            <button\n              onClick={scrollToContact}\n              className=\"flex items-center space-x-2 bg-white text-black hover:bg-neutral-200 px-5 py-3 rounded-lg text-xs font-medium tracking-tight transition-all duration-200 cursor-pointer shadow-sm\"\n              id=\"hero-btn-contact\"\n            >\n              <span>Contact Me</span>\n              <ArrowRight className=\"h-4 w-4\" />\n            </button>\n\n            <a\n              href={personalInfo.resumeUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center space-x-2 bg-neutral-950 border border-neutral-800 text-white hover:bg-neutral-900 px-5 py-3 rounded-lg text-xs font-medium tracking-tight transition-all duration-200 cursor-pointer\"\n              id=\"hero-btn-resume\"\n            >\n              <FileText className=\"h-4 w-4 text-neutral-400\" />\n              <span>Resume</span>\n            </a>\n\n            <a\n              href={personalInfo.githubUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center justify-center p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-900 transition-all cursor-pointer\"\n              aria-label=\"GitHub\"\n              id=\"hero-btn-github\"\n            >\n              <Github className=\"h-4 w-4\" />\n            </a>\n\n            <a\n              href={personalInfo.linkedinUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center justify-center p-3 rounded-lg bg-neutral-950 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-900 transition-all cursor-pointer\"\n              aria-label=\"LinkedIn\"\n              id=\"hero-btn-linkedin\"\n            >\n              <Linkedin className=\"h-4 w-4\" />\n            </a>\n          </motion.div>\n        </motion.div>\n\n        {/* Right Column: Premium Interactive Mock Workspace / AI Visualizer */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95 }}\n          animate={{ opacity: 1, scale: 1 }}\n          transition={{ duration: 1, ease: [0.16, 1, 0.3, 1], delay: 0.2 }}\n          className=\"lg:col-span-5 w-full flex justify-center\"\n          id=\"hero-right-visual\"\n        >\n          <div className=\"relative w-full max-w-[440px] aspect-[4/5] rounded-xl border border-neutral-800/80 bg-neutral-950 p-1 shadow-2xl shadow-neutral-950/50 group overflow-hidden\">\n            {/* Code editor glass header */}\n            <div className=\"flex items-center justify-between px-4 py-3 border-b border-neutral-900/80 bg-neutral-900/20\">\n              <div className=\"flex items-center space-x-1.5\">\n                <span className=\"w-2.5 h-2.5 rounded-full bg-neutral-800 block\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-neutral-800 block\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-neutral-800 block\" />\n              </div>\n              <span className=\"text-[10px] font-mono text-neutral-500 tracking-tight flex items-center space-x-1\">\n                <Terminal className=\"h-3 w-3 mr-1 text-neutral-600\" />\n                <span>agent_pipeline.py</span>\n              </span>\n              <span className=\"text-[10px] font-mono text-emerald-500/80 bg-emerald-950/20 px-2 py-0.5 rounded border border-emerald-900/30\">\n                active\n              </span>\n            </div>\n\n            {/* Code text content area */}\n            <div className=\"p-5 font-mono text-[10px] sm:text-[11px] leading-relaxed text-neutral-400 overflow-y-auto h-[calc(100%-44px)] space-y-4 select-none\">\n              <div className=\"space-y-1\">\n                <p className=\"text-neutral-500\"><span className=\"text-neutral-600\">#</span> Model Context Protocol (MCP) Bridge initialized</p>\n                <p className=\"text-purple-400\">from <span className=\"text-white\">mcp.server</span> import <span className=\"text-emerald-400\">AgentBridge</span></p>\n                <p className=\"text-purple-400\">import <span className=\"text-white\">langgraph</span> as <span className=\"text-emerald-400\">lg</span></p>\n              </div>\n\n              <div className=\"space-y-1 bg-neutral-900/30 border border-neutral-900 p-2.5 rounded\">\n                <p className=\"text-neutral-500\"><span className=\"text-neutral-600\">#</span> Active Astro/Numerology Pipeline</p>\n                <p className=\"text-blue-400\">class <span className=\"text-yellow-400\">AstrologyAIWorkflow</span>:</p>\n                <p className=\"pl-4 text-purple-400\">def <span className=\"text-teal-400\">__init__</span>(self, model=\"gemini-2.5-pro\"):</p>\n                <p className=\"pl-8 text-neutral-300\">self.bridge = AgentBridge(protocol=\"mcp\")</p>\n                <p className=\"pl-8 text-neutral-300\">self.graph = lg.StateGraph(AstrologyState)</p>\n                <p className=\"pl-4 text-purple-400\">async def <span className=\"text-teal-400\">execute_transit_analysis</span>(self, data):</p>\n                <p className=\"pl-8 text-neutral-500\"><span className=\"text-neutral-600\">#</span> Retrieve context from ephemeris database</p>\n                <p className=\"pl-8 text-neutral-300\">ctx = await self.bridge.fetch_context(data)</p>\n                <p className=\"pl-8 text-neutral-300\">return await self.graph.run(ctx)</p>\n              </div>\n\n              {/* Graphical simulation of graph node state */}\n              <div className=\"border border-neutral-900 bg-neutral-900/10 rounded-lg p-4 space-y-3\">\n                <span className=\"text-[9px] font-mono text-neutral-500 block uppercase tracking-wider\">Agent Execution Graph</span>\n                \n                <div className=\"flex flex-col space-y-2\">\n                  <div className=\"flex items-center justify-between border border-neutral-800/60 bg-neutral-900/50 rounded p-1.5 px-2.5\">\n                    <div className=\"flex items-center space-x-2\">\n                      <div className=\"h-2 w-2 rounded-full bg-neutral-700\" />\n                      <span className=\"text-[10px] text-neutral-300\">TopicResearchAgent</span>\n                    </div>\n                    <span className=\"text-[9px] text-neutral-500\">Idle</span>\n                  </div>\n\n                  <div className=\"flex items-center justify-between border border-emerald-950/50 bg-emerald-950/10 rounded p-1.5 px-2.5\">\n                    <div className=\"flex items-center space-x-2\">\n                      <div className=\"h-2 w-2 rounded-full bg-emerald-500 animate-pulse\" />\n                      <span className=\"text-[10px] text-white\">AstrologyRAGEngine</span>\n                    </div>\n                    <span className=\"text-[9px] text-emerald-400 font-medium\">Running (pgvector match)</span>\n                  </div>\n\n                  <div className=\"flex items-center justify-between border border-neutral-800/60 bg-neutral-900/50 rounded p-1.5 px-2.5\">\n                    <div className=\"flex items-center space-x-2\">\n                      <div className=\"h-2 w-2 rounded-full bg-neutral-700\" />\n                      <span className=\"text-[10px] text-neutral-300\">SEOAuditorAgent</span>\n                    </div>\n                    <span className=\"text-[9px] text-neutral-500\">Waiting</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Mock system terminal log output */}\n              <div className=\"space-y-1 text-[9px] text-neutral-500 pt-1.5 border-t border-neutral-900\">\n                <div className=\"flex items-center space-x-1.5\">\n                  <span className=\"text-emerald-500\">\342\234\223</span>\n                  <span>Numerology Calculation Matrix verified. [Pythagorean Grid: 100%]</span>\n                </div>\n                <div className=\"flex items-center space-x-1.5\">\n                  <span className=\"text-blue-400\">i</span>\n                  <span>Model Context Protocol: local database successfully bound.</span>\n                </div>\n                <div className=\"flex items-center space-x-1.5\">\n                  <span className=\"text-emerald-500\">\342\234\223</span>\n                  <span>Port 3000 linked. Running API handlers.</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Glowing accent border - subtle overlay */}\n            <div className=\"absolute inset-0 border border-transparent group-hover:border-neutral-800/50 pointer-events-none transition-colors duration-500 rounded-xl\" />\n          </div>\n        </motion.div>\n      </div>\n    </section>\n  );\n}\n"
    }
