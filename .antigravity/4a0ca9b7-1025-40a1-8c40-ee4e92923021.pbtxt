  file_change {
    absolute_path_uri: "file:///src/data/portfolioData.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "export interface Project {\n  id: string;\n  title: string;\n  problem: string;\n  solution: string;\n  techStack: string[];\n  contribution: string;\n}\n\nexport interface Experience {\n  company: string;\n  role: string;\n  period: string;\n  location: string;\n  descriptionPoints: string[];\n  techStack: string[];\n}\n\nexport interface SkillGroup {\n  category: string;\n  items: string[];\n}\n\nexport interface PersonalInfo {\n  name: string;\n  title: string;\n  headline: string;\n  email: string;\n  githubUrl: string;\n  linkedinUrl: string;\n  resumeUrl: string;\n}\n\nexport const personalInfo: PersonalInfo = {\n  name: \"Nivash R N\",\n  title: \"Associate AI Engineer\",\n  headline: \"Building production-ready AI applications using LLMs, AI Agents, MCP and scalable backend systems.\",\n  email: \"Rajnivash007@gmail.com\",\n  githubUrl: \"https://github.com\",\n  linkedinUrl: \"https://linkedin.com\",\n  resumeUrl: \"/resume/Nivash_R_N_Resume.pdf\",\n};\n\nexport const experienceData: Experience[] = [\n  {\n    company: \"AstroVed Pvt. Ltd.\",\n    role: \"Associate AI Engineer\",\n    period: \"2024 - Present\",\n    location: \"Chennai, India\",\n    descriptionPoints: [\n      \"Architect and build production-grade generative AI services, optimizing latency, reliability, and token consumption using the Gemini and OpenAI APIs.\",\n      \"Design and deploy autonomous agentic workflows using frameworks like LangGraph, orchestrating multi-agent systems that perform complex calculations and content generation.\",\n      \"Integrate Model Context Protocol (MCP) to bridge the gap between LLMs and scalable local database/file environments, enabling seamless context delivery.\",\n      \"Collaborate closely with product and engineering teams to transform traditional astrology and numerology engines into high-throughput, AI-driven platforms.\",\n      \"Optimize data engineering workflows by engineering specialized text embeddings and semantic vector database schemas to store and retrieve historical data.\"\n    ],\n    techStack: [\"Python\", \"FastAPI\", \"Node.js\", \"Express\", \"Gemini API\", \"OpenAI API\", \"PostgreSQL\", \"LangGraph\", \"Vector Databases\", \"MCP\"]\n  }\n];\n\nexport const projectsData: Project[] = [\n  {\n    id: \"numerology-platform\",\n    title: \"AI-Powered Numerology Prediction Platform\",\n    problem: \"Traditional numerology calculations and report distributions are highly manual, prone to human error, and fail to scale or deliver deeply personalized, immediate guidance for massive user bases.\",\n    solution: \"Designed and deployed a high-scale AI prediction engine that automates complex numerological grids (Pythagorean and Chaldean charts) and integrates deep semantic LLM pipelines to generate real-time, highly tailored life-path readings.\",\n    techStack: [\"Node.js\", \"Express\", \"Gemini API\", \"PostgreSQL\", \"Redis\", \"React\", \"Tailwind CSS\", \"Framer Motion\"],\n    contribution: \"Engineered the core numerological mathematical calculation engine, designed structured prompts with strict schemas for consistent output, and implemented a Redis caching layer that reduced response times by 55% during traffic spikes.\"\n  },\n  {\n    id: \"astrology-services\",\n    title: \"AI-Powered Astrology Services\",\n    problem: \"Astrological chart interpretation (Kundli, Horoscopes, Synastry) requires parsing intricate astronomical data matrices and translating them into cohesive, personalized guidance, which traditional software processes in a rigid, non-contextual manner.\",\n    solution: \"Developed an intelligent data ingestion pipeline that parses raw ephemeris and planetary transits into semantic data formats, channeling them through advanced LLM agents powered by Retrieval-Augmented Generation (RAG) to serve highly personalized, fluid readings.\",\n    techStack: [\"Python\", \"FastAPI\", \"Gemini API\", \"pgvector\", \"PostgreSQL\", \"Docker\", \"React\", \"Tailwind CSS\"],\n    contribution: \"Implemented the backend planetary transit ingestion pipeline, constructed a semantic retrieval-augmented generation (RAG) system utilizing pgvector to match transits with classical astrology texts, and designed the responsive, elegant user dashboard.\"\n  },\n  {\n    id: \"seo-content-gen\",\n    title: \"AI-Powered SEO Content Generation\",\n    problem: \"Content marketing and editorial departments struggle to maintain high SEO content generation velocities without sacrificing contextual depth, factual accuracy, brand tone, or search engine compliance.\",\n    solution: \"Created an autonomous content generation workflow leveraging multi-agent orchestration and the Model Context Protocol (MCP) to perform deep topic research, build semantic content outlines, write structurally sound articles, and verify SEO alignment in real-time.\",\n    techStack: [\"Python\", \"LangGraph\", \"Model Context Protocol (MCP)\", \"Gemini API\", \"React\", \"Tailwind CSS\", \"Vite\"],\n    contribution: \"Architected the multi-agent orchestration framework using LangGraph to split research, composition, and SEO auditing into specialized cooperative agents. Built custom Model Context Protocol (MCP) servers to retrieve live web search trends, accelerating output velocity by 40%.\"\n  }\n];\n\nexport const skillsData: SkillGroup[] = [\n  {\n    category: \"AI Engineering\",\n    items: [\n      \"Large Language Models (LLMs)\",\n      \"AI Agents\",\n      \"Model Context Protocol (MCP)\",\n      \"Prompt Engineering\",\n      \"LangChain & LangGraph\",\n      \"Retrieval-Augmented Generation (RAG)\",\n      \"Vector Search (pgvector, Pinecone)\",\n      \"Gemini & OpenAI SDKs\",\n      \"Semantic Search\"\n    ]\n  },\n  {\n    category: \"Backend\",\n    items: [\n      \"Node.js\",\n      \"Express\",\n      \"Python\",\n      \"FastAPI\",\n      \"RESTful APIs\",\n      \"gRPC\",\n      \"Serverless Functions\",\n      \"API Design\"\n    ]\n  },\n  {\n    category: \"Databases\",\n    items: [\n      \"PostgreSQL\",\n      \"MySQL\",\n      \"Redis (Caching/Queues)\",\n      \"MongoDB\",\n      \"SQL Optimization\"\n    ]\n  },\n  {\n    category: \"Frontend\",\n    items: [\n      \"React\",\n      \"TypeScript\",\n      \"Tailwind CSS\",\n      \"Framer Motion\",\n      \"Responsive UI Design\",\n      \"Performance Optimization\"\n    ]\n  },\n  {\n    category: \"Developer Tools\",\n    items: [\n      \"Git & GitHub\",\n      \"GitHub Actions (CI/CD)\",\n      \"Docker\",\n      \"Vercel\",\n      \"Postman\",\n      \"Linux/Bash\"\n    ]\n  }\n];\n\nexport const aboutData = {\n  journey: [\n    \"I am Nivash R N, an Associate AI Engineer dedicated to engineering intelligent, highly reliable, and production-ready applications. My career path lies at the intersection of robust backend software architecture and advanced artificial intelligence, driven by the belief that AI should be deeply integrated into scalable business models rather than treated as an isolated playground.\",\n    \"Currently at AstroVed Pvt. Ltd., I focus on converting mathematical, astrological, and numerological concepts into low-latency AI-driven prediction models. My daily focus involves building specialized multi-agent workflows with LangGraph, designing reliable LLM prompt chains with strict output schemas, and leveraging the Model Context Protocol (MCP) to expose data layers securely to language models.\",\n    \"I ground my engineering principles in type safety, modular component separation, rigorous performance metrics, and clean typography-first design. I believe that a great engineer is not just someone who writes clean code, but someone who builds products that solve hard scaling problems and provide seamless user experiences.\"\n  ]\n};\n"
    }
